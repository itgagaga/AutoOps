<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhiwei.superemployee.app.auth.mapper.AppRoleMapper">

    <select id="selectMenuCodesByRoleCode" resultType="java.lang.String">
        SELECT m.menu_code
        FROM app_menu m
        JOIN app_role_menu rm ON rm.menu_id = m.id
        JOIN app_role r ON r.id = rm.role_id
        WHERE r.role_code = #{roleCode} AND m.enabled = 1
        ORDER BY m.sort_order, m.menu_code
    </select>

    <select id="selectMenuIdsByRoleId" resultType="java.lang.String">
        SELECT menu_id FROM app_role_menu WHERE role_id = #{roleId} ORDER BY menu_id
    </select>

    <delete id="deleteRoleMenus">
        DELETE FROM app_role_menu WHERE role_id = #{roleId}
    </delete>

    <insert id="insertRoleMenu">
        INSERT INTO app_role_menu (role_id, menu_id) VALUES (#{roleId}, #{menuId})
    </insert>
</mapper>
